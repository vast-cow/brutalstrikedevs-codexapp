{
  "name": "@brutalstrikedevs/codexapp",
  "version": "0.1.91",
  "description": "A lightweight web interface for Codex that runs on top of the Codex app-server, allowing remote access from any browser",
  "type": "module",
  "license": "MIT",
  "author": "Pavel Voronin, Igor Levochkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/friuns2/codexui.git"
  },
  "homepage": "https://github.com/friuns2/codexui#readme",
  "bugs": {
    "url": "https://github.com/friuns2/codexui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codex",
    "openai",
    "web-ui",
    "remote",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codexapp": "dist-cli/index.js",
    "codexui": "dist-cli/index.js"
  },
  "files": [
    "dist-production/",
    "dist-cli/",
    "scripts/fix-pty-native-build.cjs",
    "scripts/run-local.cjs"
  ],
  "scripts": {
    "start": "node scripts/run-local.cjs",
    "repair:pty": "node scripts/fix-pty-native-build.cjs",
    "format:assets": "prettier --write \"dist/assets/*.js\"",
    "check:format:assets": "prettier --check \"dist/assets/*.js\"",
    "build:assets": "node scripts/build-assets.mjs",
    "check:assets": "node scripts/build-assets.mjs --check",
    "test:assets": "node --test tests/assets.test.mjs",
    "test": "npm run check:format:assets && npm run check:assets && npm run test:assets",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "terser": "5.44.0"
  }
}
